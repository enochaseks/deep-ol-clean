{
  "name": "deep-ol-clean",
  "version": "1.0.0",
  "description": "Deep Ol Clean - Professional Cleaning Services Website",
  "main": "index.html",
  "scripts": {
    "build": "npm run clean && npm run copy-files && npm run optimize",
    "clean": "powershell -Command \"if (Test-Path 'public') { Remove-Item -Recurse -Force 'public' }; New-Item -ItemType Directory -Force -Path 'public'\"",
    "copy-files": "powershell -Command \"Copy-Item -Path '*.html', '*.css', '*.js', 'images' -Destination 'public' -Recurse -Force\"",
    "optimize": "node build-optimize.js",
    "deploy": "firebase deploy --only hosting",
    "serve": "firebase serve --only hosting",
    "start": "node server.js",
    "build-and-deploy": "npm run build && npm run deploy",
    "server": "node server.js",
    "dev": "npm run server"
  },
  "keywords": [
    "cleaning",
    "services",
    "residential",
    "commercial",
    "website"
  ],
  "author": "Deep Ol Clean",
  "license": "MIT",
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "express": "^4.18.2",
    "nodemailer": "^6.9.7",
    "cors": "^2.8.5",
    "body-parser": "^1.20.2"
  }
}
